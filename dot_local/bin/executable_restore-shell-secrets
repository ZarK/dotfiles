#!/usr/bin/env bash
set -euo pipefail

# Restore ~/.zshrc.local from the 1Password document saved by
# save-shell-secrets. One-time on a new machine; after this the shell
# sources the plain file and 1Password is never consulted again.

TITLE="Shell Environment File (.zshrc.local)"
VAULT="Private"
FILE="$HOME/.zshrc.local"

if [ -f "$FILE" ]; then
  backup="$FILE.bak.$(date +%Y%m%d%H%M%S)"
  cp -p "$FILE" "$backup"
  chmod 600 "$backup"
  echo "Existing file backed up to $backup"
fi

# Create the destination with 600 before any secret bytes are written,
# then fill it via a same-directory temp file and atomic rename.
tmp=$(mktemp "$HOME/.zshrc.local.restore.XXXXXX")
trap 'rm -f "$tmp"' EXIT
chmod 600 "$tmp"
op document get "$TITLE" --vault "$VAULT" > "$tmp"
mv "$tmp" "$FILE"
trap - EXIT
chmod 600 "$FILE"
echo "Restored $FILE from 1Password ($VAULT / $TITLE)"

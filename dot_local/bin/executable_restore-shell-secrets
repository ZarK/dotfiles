#!/usr/bin/env bash
set -euo pipefail

# Restore ~/.zshrc.local from the 1Password document saved by
# save-shell-secrets. One-time on a new machine; after this the shell
# sources the plain file and 1Password is never consulted again.

TITLE="Shell Environment File (.zshrc.local)"
VAULT="Private"
FILE="$HOME/.zshrc.local"

if [ -f "$FILE" ]; then
  backup="$FILE.bak.$(date +%Y%m%d%H%M%S)"
  cp -p "$FILE" "$backup"
  echo "Existing file backed up to $backup"
fi

op document get "$TITLE" --vault "$VAULT" --out-file "$FILE" --force >/dev/null
chmod 600 "$FILE"
echo "Restored $FILE from 1Password ($VAULT / $TITLE)"

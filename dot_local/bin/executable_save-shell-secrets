#!/usr/bin/env bash
set -euo pipefail

# Save ~/.zshrc.local (plain-text secrets file) to 1Password as a document.
# One-time (or whenever you change a key). Day-to-day shell startup never
# touches 1Password: .zshrc sources the plain file directly.
#
# Restore on a new machine with: restore-shell-secrets

TITLE="Shell Environment File (.zshrc.local)"
VAULT="Private"
FILE="$HOME/.zshrc.local"

if [ ! -f "$FILE" ]; then
  echo "Error: $FILE does not exist" >&2
  exit 1
fi

# Distinguish "document missing" from other op failures (not signed in,
# network, ambiguous title): only a clear not-found may fall through to
# create, so a transient failure cannot produce a duplicate document.
set +e
lookup_err=$(op document get "$TITLE" --vault "$VAULT" 2>&1 >/dev/null)
lookup_status=$?
set -e

if [ "$lookup_status" -eq 0 ]; then
  op document edit "$TITLE" "$FILE" --vault "$VAULT"
  echo "Updated existing 1Password document: $VAULT / $TITLE"
elif printf '%s' "$lookup_err" | grep -qiE "isn't an item|not found|no item|could not find"; then
  op document create "$FILE" --title "$TITLE" --vault "$VAULT" >/dev/null
  echo "Created 1Password document: $VAULT / $TITLE"
else
  echo "Error: could not check for existing document; not creating a duplicate." >&2
  echo "op said: $lookup_err" >&2
  exit 1
fi

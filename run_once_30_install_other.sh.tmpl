#!/usr/bin/env bash
set -uo pipefail

# Installs pnpm (standalone — needs no Node; Node itself comes from asdf in
# the next script). Never exits nonzero; failures are reported, not fatal.

if command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is already installed."
else
  echo "Installing pnpm via the official standalone script..."
  if ! curl -fsSL https://get.pnpm.io/install.sh | sh -; then
    echo "WARNING: pnpm install failed. Retry later with:"
    echo "  curl -fsSL https://get.pnpm.io/install.sh | sh -"
    exit 0
  fi
fi

# Supply-chain cooldown: only install packages at least 7 days old.
PNPM_BIN="$(command -v pnpm || echo "$HOME/Library/pnpm/pnpm")"
if [ -x "$PNPM_BIN" ]; then
  "$PNPM_BIN" config set --global minimumReleaseAge 10080 || \
    echo "WARNING: could not set pnpm minimumReleaseAge; set it manually."
fi

exit 0

# ~/.zprofile

# Standard Homebrew (Apple Silicon)
eval "$(/opt/homebrew/bin/brew shellenv)"

# Extra tools you actually use
export PATH="$HOME/.npm-global/bin:$PATH"        # npm global
export PATH="$HOME/.lmstudio/bin:$PATH"          # LM Studio

# OrbStack (load silently if present)
source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null || true

# OpenCode CLI
_opencode_bin="$HOME/.opencode/bin"
case ":$PATH:" in
  *":${_opencode_bin}:"*) ;;
  *) export PATH="${_opencode_bin}:$PATH" ;;
esac
unset _opencode_bin

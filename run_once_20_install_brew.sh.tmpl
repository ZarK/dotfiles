#!/usr/bin/env bash
set -euo pipefail

# Use the standard Homebrew install (setup in README)
BREW_BIN="/opt/homebrew/bin/brew"
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

# Pass 1: taps, formulae and casks — these must succeed.
# Mac App Store entries are excluded here because mas fails whenever
# App Store.app is not signed in or an app was never "purchased" on
# this Apple ID, and that must not abort the whole chezmoi apply.
NOMAS_BREWFILE="$(mktemp)"
trap 'rm -f "$NOMAS_BREWFILE"' EXIT
grep -v '^mas ' "$BREWFILE" > "$NOMAS_BREWFILE"
"$BREW_BIN" bundle --file="$NOMAS_BREWFILE"

# Pass 2: the full Brewfile including mas — best effort.
# Already-installed entries are no-ops; only the mas installs are new.
if ! "$BREW_BIN" bundle --file="$BREWFILE"; then
  echo ""
  echo "WARNING: some Mac App Store installs failed (sign-in or purchase missing)."
  echo "Sign in to App Store.app, then rerun:"
  echo "  brew bundle --file=\"$BREWFILE\""
  echo "Continuing with the rest of the setup."
fi

# fzf post-install (adds key-bindings & completions) if not already configured
if "$BREW_BIN" --prefix fzf &>/dev/null; then
  if ! grep -q "fzf/shell/key-bindings.zsh" ~/.zshrc 2>/dev/null; then
    echo "Setting up fzf key bindings and completions..."
    "$( "$BREW_BIN" --prefix fzf )/install" --all --no-bash --no-fish --no-update-rc
  else
    echo "fzf key bindings already configured in ~/.zshrc"
  fi
fi

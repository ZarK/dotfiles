#!/usr/bin/env bash
set -uo pipefail

# Installs the Brewfile bundle. This script NEVER exits nonzero: a failed
# entry must not abort chezmoi apply and block the remaining run_once
# scripts. Failures are reported at the end with the command to fix them.
# Casks adopt manually pre-installed apps (cask_args adopt in the Brewfile).
# Mac App Store apps are installed by run_once_60_setup_mas.sh, not here.

BREW_BIN="/opt/homebrew/bin/brew"
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

if [ ! -x "$BREW_BIN" ]; then
  echo "WARNING: Homebrew not found at $BREW_BIN - skipping bundle install."
  echo "Install Homebrew (README step 3), then run: brew bundle --file=\"$BREWFILE\""
  exit 0
fi

echo "Installing Brewfile bundle (individual failures are reported, never fatal)..."
"$BREW_BIN" bundle --file="$BREWFILE" || true

echo ""
if "$BREW_BIN" bundle check --file="$BREWFILE" >/dev/null 2>&1; then
  echo "Brewfile: everything installed."
else
  echo "WARNING: some Brewfile entries are still missing:"
  "$BREW_BIN" bundle check --verbose --file="$BREWFILE" 2>&1 | grep -iE 'missing|not installed|→' || true
  echo "Fix whatever blocks them (network, disk space), then rerun:"
  echo "  brew bundle --file=\"$BREWFILE\""
fi

# fzf post-install (key-bindings & completions), also best-effort
if "$BREW_BIN" --prefix fzf >/dev/null 2>&1; then
  if ! grep -q "fzf/shell/key-bindings.zsh" ~/.zshrc 2>/dev/null; then
    echo "Setting up fzf key bindings and completions..."
    "$( "$BREW_BIN" --prefix fzf )/install" --all --no-bash --no-fish --no-update-rc || true
  fi
fi

exit 0

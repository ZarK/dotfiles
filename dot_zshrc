# ~/.zshrc  ─ lean and readable

HISTSIZE=100000
SAVEHIST=$HISTSIZE
setopt INC_APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS

if [[ "$PWD" != "$(pwd -P)" ]]; then
  builtin cd -qP . 2>/dev/null
fi

if [[ -L /usr/local/share/zsh/site-functions/_mdatp && ! -e /usr/local/share/zsh/site-functions/_mdatp ]]; then
  fpath=(${fpath:#/usr/local/share/zsh/site-functions})
fi

# Prompt & helpers
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# fzf keys (load if it exists, else ignore)
[[ -f "/opt/homebrew/opt/fzf/shell/key-bindings.zsh" ]] && \
  source "/opt/homebrew/opt/fzf/shell/key-bindings.zsh"

# Aliases
alias ls='eza -lah --group-directories-first'
alias tailscale='/Applications/Tailscale.app/Contents/MacOS/Tailscale'
alias edit='RETURN_DIR=$(pwd) && nano ~/.zshrc && cd "$RETURN_DIR" && source ~/.zshrc'

# Developer Tools
alias code='"/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"'
alias orb='"/Applications/OrbStack.app/Contents/MacOS/orb"'

# Browsers
alias vivaldi='open -a Vivaldi'

# Media
alias vlc='open -a VLC'

# Productivity
alias obsidian='open -a Obsidian'
alias raycast='open -a Raycast'

# Utilities
alias keka='open -a Keka'
alias localai="$HOME/tools/opencode-local/start-opencode-local.sh"
alias protonmail='open -a "Proton Mail"'

if [ -d "$HOME/.ai/bin" ]; then
  export PATH="$HOME/.ai/bin:$PATH"
fi

# asdf version manager
[ -f /opt/homebrew/opt/asdf/libexec/asdf.sh ] && . /opt/homebrew/opt/asdf/libexec/asdf.sh

# Exports
export EDITOR=nano

# Local secrets and machine-specific overrides
if [ -f "$HOME/.zshrc.local" ]; then
  source "$HOME/.zshrc.local"
fi

# dotnet
export DOTNET_ROOT=$HOME/.asdf/installs/dotnet/10.0.101

# Added by Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/.dotnet/tools"
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"

# cubic
export PATH="$HOME/.cubic/bin:$PATH"

# Added by git-ai installer
export PATH="$HOME/.git-ai/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# OpenCode profile launcher: enables `opencode zen` and `opencode copilot`.
if [ -f "$HOME/.config/opencode/opencode-profile.zsh" ]; then
  source "$HOME/.config/opencode/opencode-profile.zsh"
fi

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
# <<< grok installer <<<

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

alias beekeeper="open -a 'Beekeeper Studio'"
alias tfgui="python3 $HOME/Github/fold-studio/server.py"
codex() { open -a Codex "${1:-.}"; }
# oMLX: CLI shim path begin
case ":$PATH:" in
  *":$HOME/.omlx/bin:"*) ;;
  *) export PATH="$HOME/.omlx/bin:$PATH" ;;
esac
# oMLX: CLI shim path end

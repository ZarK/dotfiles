#!/usr/bin/env bash
set -uo pipefail

# Installs asdf plugins and current runtimes. This script NEVER exits
# nonzero: a failed install must not abort chezmoi apply. Failures are
# collected and reported at the end with how to retry.
# Versions are derived dynamically — nothing hardcoded to go stale.

FAILED=""
note_fail() {
  FAILED="$FAILED $1"
  echo "WARNING: $1 failed - continuing."
}

if ! command -v asdf >/dev/null 2>&1; then
  echo "WARNING: asdf not found on PATH - skipping runtime setup."
  echo "Install it (brew install asdf), then rerun this script:"
  echo "  bash {{ .chezmoi.sourceDir }}/run_once_40_install_setup_asdf.sh.tmpl"
  exit 0
fi

for plugin in python nodejs dotnet rust golang; do
  asdf plugin add "$plugin" >/dev/null 2>&1 || true
done

# Python: latest patch release of the three newest 3.x minor lines
PY_ALL="$(asdf list all python 2>/dev/null | grep -E '^3\.[0-9]+\.[0-9]+$' || true)"
if [ -n "$PY_ALL" ]; then
  for minor in $(printf '%s\n' "$PY_ALL" | awk -F. '{print $1"."$2}' | sort -t. -k2,2n | uniq | tail -3); do
    latest="$(printf '%s\n' "$PY_ALL" | grep -E "^${minor}\.[0-9]+$" | sort -t. -k3,3n | tail -1)"
    if [ -n "$latest" ]; then
      echo "Installing Python $latest"
      asdf install python "$latest" || note_fail "python-$latest"
    fi
  done
else
  note_fail "python-version-discovery"
fi

# Node.js: latest release of the two most recent LTS lines
NODE_LTS="$(curl -fsS --max-time 30 https://nodejs.org/dist/index.tab 2>/dev/null \
  | awk 'NR>1 && $10 != "-" && $10 != "" {print $10, $1}' \
  | sort -k1,1 -k2,2V \
  | awk '{versions[$1]=$2} END {for (k in versions) print versions[k]}' \
  | sed 's/^v//' \
  | sort -V \
  | tail -2 || true)"
if [ -n "$NODE_LTS" ]; then
  for version in $NODE_LTS; do
    echo "Installing Node.js $version"
    asdf install nodejs "$version" || note_fail "nodejs-$version"
  done
else
  note_fail "nodejs-lts-discovery"
fi

# .NET: latest patch of the two most recent LTS majors (even-numbered)
DOTNET_ALL="$(asdf list all dotnet 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true)"
if [ -n "$DOTNET_ALL" ]; then
  for major in $(printf '%s\n' "$DOTNET_ALL" | awk -F. '{print $1}' | sort -n | uniq | awk '$1 % 2 == 0' | tail -2); do
    latest="$(printf '%s\n' "$DOTNET_ALL" | grep -E "^${major}\.[0-9]+\.[0-9]+$" | sort -V | tail -1)"
    if [ -n "$latest" ]; then
      echo "Installing .NET $latest"
      asdf install dotnet "$latest" || note_fail "dotnet-$latest"
    fi
  done
else
  note_fail "dotnet-version-discovery"
fi

# Rust and Go: latest stable release
for tool in rust golang; do
  latest="$(asdf list all "$tool" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+(\.[0-9]+)?$' | sort -V | tail -1 || true)"
  if [ -n "$latest" ]; then
    echo "Installing $tool $latest"
    asdf install "$tool" "$latest" || note_fail "$tool-$latest"
  else
    note_fail "$tool-version-discovery"
  fi
done

# Set global versions, then reshim.
# Python global pins the SECOND-newest installed minor: a weeks-old x.y.0
# still misses wheels (torch etc.); projects opt into the newest via uv or
# their own .tool-versions. Everything else gets the newest installed.
py_global="$(asdf list python 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/^\*//' | sort -V | awk -F. '{minors[$1"."$2]=$0} END {for (m in minors) print minors[m]}' | sort -V | tail -2 | head -1)"
if [ -n "$py_global" ]; then
  echo "Setting global python -> $py_global (second-newest minor; newest is installed for opt-in)"
  asdf set python "$py_global" || note_fail "set-global-python"
fi
for tool in nodejs dotnet rust golang; do
  newest="$(asdf list "$tool" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/^\*//' | sort -V | tail -1)"
  if [ -n "$newest" ]; then
    echo "Setting global $tool -> $newest"
    asdf set "$tool" "$newest" || note_fail "set-global-$tool"
  fi
done
asdf reshim || true

echo ""
if [ -n "$FAILED" ]; then
  echo "WARNING: some runtime installs failed:$FAILED"
  echo "Retry later with, e.g.:  asdf install python <version>"
else
  echo "asdf runtimes installed and globals set."
fi
exit 0
